# Backend secrets — copy this file to `.env` and fill in real values.
# NEVER commit `.env`, and NEVER expose the service role key to the frontend.

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Supabase "service_role" secret key (Project Settings → API).
# This bypasses Row Level Security — keep it server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# Origin allowed to call this API (the Vite dev server default).
CLIENT_ORIGIN=http://localhost:5173

# Port this server listens on.
PORT=3001

# Frontend env — copy this file to `.env` and fill in real values.
# Only the Supabase URL and the PUBLIC "anon" key belong here. These are safe
# to ship to the browser. NEVER put the service role key in the client.
#
# Vite only exposes vars prefixed with VITE_ to the app.

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Supabase "anon public" key (Project Settings → API).
VITE_SUPABASE_ANON_KEY=

# Base URL of the Express backend.
VITE_API_URL=http://localhost:3001
